          "text_sha256": "ddf5bd5c54ac99aeeebb9f1caf147d0a493c1ec2419f3dc6c85efbd0e6d441e1",
          "spoken_sha256": "ddf5bd5c54ac99aeeebb9f1caf147d0a493c1ec2419f3dc6c85efbd0e6d441e1",
          "run_on": {
            "spoken_text": "昨晚延迟的那次记录要留着；后面几次都按时了，也抹不掉它。",
            "cut_sample": 402000
          }
        },
        "5": {
          "seed": 91792,
          "text_sha256": "5f61fdcfdb29d1daf7227c07e940058e642e79b088d029f9c0322b5cf3c53c70",
          "spoken_sha256": "5f61fdcfdb29d1daf7227c07e940058e642e79b088d029f9c0322b5cf3c53c70",
          "run_on": {
            "spoken_text": "每次说完成，都要答得上来：说的是什么，针对哪个对象、哪个版本？谁在什么时候、用什么方法核验的？覆盖了什么，还有什么没证明？证据不够，就收窄说法，别把话说大。",
            "cut_sample": 423120
          }
        }
      }
